# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose to browser

# Anthropic (for AI scoring / drafting / campaign generation)
ANTHROPIC_API_KEY=sk-ant-...

# Stripe (Developers -> API keys)
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_AGENCY=price_...

# Used to build checkout success/cancel URLs and webhook verification links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WhatsApp Cloud API webhook verification (you choose this string, enter it in Meta App dashboard too)
WHATSAPP_VERIFY_TOKEN=choose-a-random-string

# Meta Lead Ads webhook verification
META_VERIFY_TOKEN=choose-a-random-string
